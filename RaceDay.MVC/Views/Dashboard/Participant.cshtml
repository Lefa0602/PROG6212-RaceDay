@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">
    <h1 class="fw-bold mb-2">Participant Dashboard</h1>
    <p class="text-muted mb-4">Welcome to your RaceDay participant area.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Browse Events</h5>
                    <p class="card-text">Explore upcoming running, walking and cycling events.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Enrolments</h5>
                    <p class="card-text">View the events you have entered.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>
                    <p class="card-text">View your published race results.</p>
                </div>
            </div>
        </div>
    </div>
</div>
