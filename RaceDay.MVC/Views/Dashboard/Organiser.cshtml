@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">
    <h1 class="fw-bold mb-2">Organiser Dashboard</h1>
    <p class="text-muted mb-4">Welcome to your RaceDay organiser area.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Events</h5>
                    <p class="card-text">Create, update and manage your sporting events.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Categories</h5>
                    <p class="card-text">Manage event distances, entry fees and participant limits.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Enrolments and Results</h5>
                    <p class="card-text">View participant enrolments and manage race results.</p>
                </div>
            </div>
        </div>
    </div>
</div>
